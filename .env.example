# =============================================================================
# ResumAI — environment configuration
# =============================================================================
# Copy this file to `.env` and fill in your own values:
#     cp .env.example .env
#
# NOTHING in this file is a real secret — every value below is a safe placeholder.
# Never commit a real `.env`. It is already covered by .gitignore.
#
# Variables are grouped into two very different scopes:
#   1) FRONTEND (VITE_*)  -> bundled into the browser build. Public by design.
#   2) EDGE FUNCTIONS     -> server-side only. Set with the Supabase CLI:
#                            `supabase secrets set NAME=value`
#                            (or in the Supabase Dashboard -> Edge Functions).
#                            These must NEVER be prefixed VITE_ or shipped to the client.
# =============================================================================


# -----------------------------------------------------------------------------
# 1) FRONTEND — exposed to the browser (safe: protected by Row Level Security)
# -----------------------------------------------------------------------------

# REQUIRED. Your Supabase project URL. Dashboard -> Project Settings -> API.
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"

# REQUIRED. Supabase anon (publishable) key. Dashboard -> Project Settings -> API.
# This is a public key; access is restricted by RLS policies, not by secrecy.
VITE_SUPABASE_ANON_KEY="your-anon-publishable-key"

# OPTIONAL. Public base URL of the deployed app (used for auth redirects).
# Defaults to window.location.origin when unset.
# VITE_APP_BASE_URL="http://localhost:8080"


# -----------------------------------------------------------------------------
# 2) EDGE FUNCTIONS — server-side secrets (set via `supabase secrets set ...`)
# -----------------------------------------------------------------------------
# When running functions locally with `supabase functions serve`, put these in
# `supabase/.env` (gitignored) instead of here.

# --- AI provider (Bring Your Own Key) ---------------------------------------
# The AI layer is provider-agnostic. Choose one:
#   openai            -> OpenAI (default)
#   deepseek          -> DeepSeek (OpenAI-compatible)
#   openai-compatible -> any OpenAI-compatible endpoint (Groq, Together, Ollama, LM Studio, ...)
#   mock              -> deterministic offline responses, NO network, NO cost (great for demos/tests)
AI_PROVIDER="openai"

# API key for the selected provider. Not required when AI_PROVIDER=mock.
# (OPENAI_API_KEY is still read as a fallback for backwards compatibility.)
AI_API_KEY="sk-your-provider-key"

# OPTIONAL overrides. Sensible defaults are applied per provider when unset.
# AI_BASE_URL="https://api.openai.com/v1"      # e.g. https://api.deepseek.com/v1
# AI_MODEL="gpt-4o"                            # e.g. deepseek-chat
# AI_TEMPERATURE="0.7"
# AI_MAX_TOKENS="1000"
# AI_TIMEOUT_MS="30000"
# AI_MAX_RETRIES="2"

# --- Supabase (needed by functions that use the service role) ----------------
# In Supabase-hosted functions SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY are
# injected automatically; set them only for local `functions serve`.
# SUPABASE_URL="https://your-project-ref.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"   # SERVER ONLY. Never expose.

# --- Flow.cl payments (OPTIONAL — only if you enable subscriptions) ----------
# FLOW_API_KEY="your-flow-api-key"
# FLOW_SECRET_KEY="your-flow-secret-key"
# FLOW_ENV="sandbox"                           # "sandbox" | "production"
# FLOW_BASE_URL="https://sandbox.flow.cl/api"  # overrides FLOW_ENV if set
# APP_BASE_URL="http://localhost:8080"         # return URL after checkout
