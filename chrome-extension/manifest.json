{
  "manifest_version": 3,
  "name": "ResumAI Job Assistant",
  "version": "1.0.0",
  "description": "Automatiza la postulación a empleos en portales chilenos usando tus CVs de ResumAI",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://trabajando.cl/*",
    "https://www.trabajando.cl/*",
    "https://laborum.com/*",
    "https://www.laborum.com/*",
    "https://getonboard.com/*",
    "https://www.getonboard.com/*",
    "https://jwitsagioonykrabioku.supabase.co/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://trabajando.cl/*",
        "https://www.trabajando.cl/*",
        "https://laborum.com/*",
        "https://www.laborum.com/*",
        "https://getonboard.com/*",
        "https://www.getonboard.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ResumAI Job Assistant",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["content.css", "injected.js"],
      "matches": ["*://*.trabajando.cl/*", "*://*.laborum.com/*", "*://*.getonboard.com/*"]
    }
  ]
}
